# ---------- Public site settings (safe to expose to the browser) ----------
NEXT_PUBLIC_SITE_URL=https://www.yourcompany.com
NEXT_PUBLIC_CONTACT_EMAIL=sales@yourcompany.com
NEXT_PUBLIC_CONTACT_PHONE="+91 00000 00000"
# Digits only, with country code, no "+" (used for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
# Google Maps -> Share -> Embed a map -> copy ONLY the src="..." URL. Leave blank to hide the map.
NEXT_PUBLIC_MAPS_EMBED_URL=

# ---------- Email notifications (server only) ----------
# Any SMTP provider works (Google Workspace, Zoho, Amazon SES, Brevo, Postmark, etc.)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where new enquiries are delivered (comma-separate for several recipients)
LEAD_TO_EMAIL=sales@yourcompany.com
# Must be an address your SMTP provider allows you to send from
LEAD_FROM_EMAIL="Website <no-reply@yourcompany.com>"
# Send the visitor an automatic "we received your request" email
SEND_CONFIRMATION_EMAIL=true
